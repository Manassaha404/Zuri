# Server
PORT=8000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/zuri

# JWT
JWT_ACCESS_TOKEN_SERECT=your_access_token_secret_here
JWT_ACCESS_TOKEN_EXPIRY=10m
JWT_REFRESH_TOKEN_SERECT=your_refresh_token_secret_here
JWT_REFRESH_TOKEN_EXPIRY=7d

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback

# OpenAI
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Encryption
ENCRYPTION_SECRET=your_32_char_encryption_secret_here

# URLs
CLIENT_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Inngest
INNGEST_DEV=1

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Qdrant (Vector DB)
QDRANT_URL=http://localhost:6333
