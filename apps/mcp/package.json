{
  "name": "mcp",
  "version": "1.0.0",
  "description": "Multi-User Remote FastMCP Server with OAuth 2.1 & Email/Password Auth",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/database": "workspace:*",
    "@repo/error": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/redis": "workspace:*",
    "@repo/services": "workspace:*",
    "dotenv": "^17.4.2",
    "fastmcp": "^4.27.0",
    "hono": "^4.12.21",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.15.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
